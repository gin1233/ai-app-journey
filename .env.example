# ============================================================
# 配置模板
#
# 用法：把这个文件复制一份，改名为 .env，然后填入你自己的真实值
#       cp .env.example .env     (PowerShell: Copy-Item)
#
# 重要：.env 已经被 .gitignore 排除，永远不会被提交
#       但 .env.example 会提交，用来说明"需要配哪些东西"
# ============================================================

# ===== 应用配置 =====
APP_NAME=ai-app-journey
APP_ENV=development
LOG_LEVEL=INFO

# ===== 大模型 API =====
# 等你学到"接入大模型"那一课，把真实的 Key 填进你自己的 .env
# 这里只放占位符，绝对不要填真 Key
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx