# ===== 默认规则 =====
# 自动识别文本文件，统一用 LF 存储，检出时也保持 LF
* text=auto eol=lf

# ===== Windows 专属脚本：必须用 CRLF =====
# .bat / .cmd 用 LF 会出各种诡异问题
*.bat text eol=crlf
*.cmd text eol=crlf

# ===== 明确标记为文本 =.=====
*.py    text
*.md    text
*.txt   text
*.json  text
*.yml   text
*.yaml  text
*.toml  text
*.ini   text
*.cfg   text
*.html  text
*.css   text
*.js    text
*.ts    text
*.sh    text

# ===== 二进制文件：绝不做任何转换 =====
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.svg   text

*.pdf   binary
*.zip   binary
*.gz    binary
*.xlsx  binary
*.docx  binary

*.exe   binary
*.dll   binary
*.so    binary
*.woff  binary
*.woff2 binary

# ===== 数据文件 =====
*.csv   text
*.sql   text
*.ipynb text